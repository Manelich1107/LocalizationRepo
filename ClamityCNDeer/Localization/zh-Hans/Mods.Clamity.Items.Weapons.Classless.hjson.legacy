AMS: {
	DisplayName: AMS
	Tooltip:
		'''
		使用魔法制造炸弹
		右击增加爆炸半径(最多5倍)
		'''
}

TrashOfMagnus: {
	DisplayName: 马格努斯之屑
	Tooltip:
		'''
		马格努斯尝试扩展瘟疫的产物
		尽管他付出了努力，但它最终被认定为失败品并被丢弃
		发射造成瘟疫减益的瘟疫弹
		这个武器会同时受到所有伤害属性加成
		'''
}

EyeOfNova: {
	Tooltip:
		'''
		发射强大的追踪星流光束，降低敌人的保护、防御并减速
		命中时恢复魔力和生命值
		这个武器会同时受到所有伤害属性加成
		'''
	DisplayName: 新星之眼
}

Celesticus: {
	Tooltip:
		'''
		发射会爆炸并减速敌人的水晶
		这个武器会同时受到所有伤害属性加成
		'''
	DisplayName: 天界之器
}
