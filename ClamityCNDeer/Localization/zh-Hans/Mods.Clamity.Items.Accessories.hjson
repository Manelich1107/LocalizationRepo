Wings: {
	MetalWings: {
		DisplayName: 青铜之翼
		Tooltip:
			'''
			水平速度：10.50
			加速倍率：2.8
			极佳的垂直速度
			飞行时间：280
			受到伤害时，获得等于受到伤害与最大生命值比率一半的飞行时间百分比
			穿戴寒狱套时，队伍中所有玩家获得20点防御力
			'''
		HoldShiftTooltip: 恢复的飞行时间等于所受伤害占最大生命值比例的一半
	}
}

SoulOfPyrogen: {
	DisplayName: 极炎之魄
	Tooltip:
		'''
		提升10%近战与盗贼伤害
		真近战攻击和潜伏攻击会从地底呼唤长矛攻击
		'''
}

DraculasCharm: {
	DisplayName: 吸血鬼护身符
	Tooltip:
		'''
		盗贼伤害增加15%，最大潜伏值提升10点
		盗贼弹幕在暴击时获得生命窃取
		潜伏攻击会使非潜伏攻击获得15%暴击率并提高吸血效果，持续10秒
		潜伏攻击会造成重度出血和粉碎减益，并增加8%伤害
		潜伏攻击会召唤一群吸血蝙蝠
		盗贼弹幕会爆裂成追踪的灵魂
		“持有这枚护符会让你渴求鲜血与灵魂”
		'''
}

PyroStone: {
	DisplayName: 火山石
	Tooltip:
		'''
		所有火焰减益的伤害倍率增加50%
		创造一个环绕着你的火盾，火盾会伤害并点燃与其接触的敌人
		"远古遗物之一"
		'''
}

HellFlare: {
	DisplayName: 阳炎之霜
	Tooltip:
		'''
		所有攻击和弹幕造成会造成狱炎减益
		使你免疫"着火了！"和"狱炎"减益
		生命值超过75%会增加10%的暴击几率
		生命值低于25%会增加10%的伤害减免
		使你获得对冷系攻击的抗性
		'''
}

SupremeBarrier: {
	DisplayName: 至尊屏障
	Tooltip:
		'''
		{$Mods.CalamityMod.Common.KnockbackImmunity}
		获得被宇宙狱火加强的撞击冲刺能力
		此冲刺可以在不受伤害的情况下猛击穿过敌怪
		受到伤害后释放一阵追踪星蜂[TOGGLE]并使你浸满[cbuff:Honey]
		增加受伤的无敌帧，在低生命值或承受高伤害攻击时进一步增加
		当生命值低于50%时，减少受到伤害的25%
		生命值高于25%时，为队内队友承担25%所受伤害
		[c/aaaaaa:在物品栏中Shift-右键点击此物品来切换][i:PanicNecklace][c/aaaaaa:恐慌项链效果]
		'''
	ToggleEffect: ，提高移速，
}

IcicleRing: {
	DisplayName: 寒狱冰戒
	Tooltip:
		'''
		魔力消耗降至零
		穿戴者持续承受痛苦带来的伤害
		'''
}

RedDie: {
	DisplayName: 红色骰子
	Tooltip:
		'''
		1.5倍幸运修正
		额外幸运提升20%
		“准备重掷命运了吗？”
		'''
}

EidolonAmulet: {
	DisplayName: 幽灵护符
	Tooltip:
		'''
		<这是饰品重做前的占位文本>
		水系减益的伤害提高60%
		缓慢积攒最多三种不同的深渊之魂
		冲刺以驱散灵魂，并让它们攻击敌人
		在[c/CB7AD7:生命值低于50%]时驱散，魂灵会转而支援你
		魂灵会依次出现，并根据颜色拥有不同效果：
		[c/3CB371:命中时爆炸并施加深渊水压减益]/[c/CB7AD7:恢复8点生命值]
		[c/FF4500:穿透敌人并施加狱火减益]/[c/CB7AD7:临时增加10点防御]
		[c/1E90FF:多次命中并施加深渊重压减益]/[c/CB7AD7:恢复5%最大生命值]
		关闭可见性时，魂灵会变得透明且无声
		'''
}

TreasureOfClamity: {
	DisplayName: 灾蛤宝藏
	Tooltip:
		'''
		增加25点渔力
		提高作为药水材料的鱼的产量
		钓起板条箱和含有战利品的鱼的几率提高15%
		钓起的板条箱有25%几率品质更高，并伴随珍珠状视觉效果[TOGGLE]
		[c/aaaaaa:在物品栏中Shift-右键点击此物品来切换][i:CalamityMod/PearlofEnthrallment][c/aaaaaa:魅惑珍珠的召唤效果]
		'''
	ToggleEffect:
		'''
			
		召唤水之元素为你而战
		'''
}

SeaShell: {
	DisplayName: 海蜗牛壳
	Tooltip: 潮湿时提升防御力、伤害减免和移动速度
}

TheSubcommunity: {
	DisplayName: 社区之心
	Tooltip:
		'''
		[STATS]
		“来自灾厄社区的一份礼物。”
		“凝聚着社区的力量。”
		[c/B00BA5:感谢所有支持者让这个附加内容成为现实！]
		'''
	StatsList:
		'''
		提高挖掘速度{0}%
		提高{1}幸运值和{2}渔力
		提高{3}%放置方块和墙壁的速度和{4}放置范围
		随着击败Boss变得更强（{5}%攻击力）
		'''
}

MagicDiamond: {
	DisplayName: 魔法钻石
	Tooltip:
		'''
		造成魔法伤害时创造一个小型屏障
		每次魔法攻击都会为屏障增加少量耐久度
		屏障最多可储存20点耐久度
		'''
}

SharpAmethyst: {
	DisplayName: 锋利紫水晶
	Tooltip:
		'''
		射箭时有几率创造额外的宝石箭
		宝石箭造成箭矢20%的伤害
		'''
}

BlightedSpyglass: {
	DisplayName: 枯萎望远镜
	Tooltip:
		'''
		+1最大哨兵数量
		哨兵攻击会施加硫磺火焰
		'''
}

CyanPearl: {
	DisplayName: 青色珍珠
	Tooltip:
		'''
		+7%召唤伤害
		哨兵的召唤伤害惩罚减半
		'''
	HoldShiftTooltip:
		'''
			  手持非召唤/无职业武器时，哨兵造成0.875倍伤害，而非0.75倍
			  手持无职业武器或处于撒旦军团事件中时，也不会受到惩罚
		'''
}

SkullOfTheBloodGod: {
	DisplayName: 血神之颅
	Tooltip:
		'''
		伤害提升15%且暴击率提升13%
		暴击会爆炸，使附近敌人被[cbuff:CalamityMod/BrimstoneFlames]点燃
		每20秒冷却时间减半敌人接触伤害[TOGGLE]
		受到[cbuff:CalamityMod/BrimstoneFlames]的伤害降低50%
		[c/aaaaaa:在物品栏中Shift-右键点击此物品来切换][i:CalamityMod/VoidofCalamity][c/aaaaaa:灾劫虚空的硫磺火雨效果]
		'''
	ToggleEffect:
		'''
			
		被击中时会使硫磺火雨从天而降
		'''
}
