Items: {
	Mounts: {
		FlameCube: {
			DisplayName: 硫火王座
			Tooltip:
				'''
				召唤一个相当舒适且极其灵活的飞行硫磺火王座
				坐在王座上时按住[KEY]可以减慢移动速度以提高精确度
				'舒适的玩家，往往是最危险的对手'
				'''
		}

		PlagueStation: {
			DisplayName: 瘟疫王座
			Tooltip:
				'''
				召唤一个相当舒适且极其灵活的飞行瘟疫王座
				坐在王座上时按住[KEY]可以减慢移动速度以提高精确度
				'玩游戏太上头的狂热粉，跟病毒似的难缠'
				'''
		}
	}

	Weapons: {
		Classless: {
			AMS: {
				DisplayName: AMS
				Tooltip:
					'''
					使用魔法制造炸弹
					右击增加爆炸半径(最多5倍)
					'''
			}
		}
	}
}

