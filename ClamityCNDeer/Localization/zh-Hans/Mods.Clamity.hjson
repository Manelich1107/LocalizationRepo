Dialogues: {
	Yharim: {
		Intro: {
			Text1: 你好，泰拉人...
			Text2: 我们的道路在此交汇
			Text3: 我看到你净化了这个世界
			Text4: 我看到你击败了神明，甚至是龙
			Text5: 而你来到这里寻找我...
			Text6: 来到龙之领域...
			Text7: 展示你的力量吧！
			Text8: 展示你有多么配得上战胜真正的邪恶！
		}

		PlayerKilled: {
			Text1: 弱小...
			Text2: 力量不足...
			Text3: 你不配！
		}

		Defeated: {
			Text1: 啊！
			Text2: 哦...
			Text3: 最后的弑神者倒下了
			Text4: 我不够强大。我犯了太多错误
			Text5: 这里是我最后的战场。但不是战争的终点
			Text6: 哦... 你需要继续我的使命
		}
	}

	Architect: {
		Abyss: {
			Text1: 最伟大的创造...
			Text2: 想要探索秘密
			Text3: 他坠入世界深处寻找新的问题
			Text4: 但现在还不是解答的时候
		}

		PostWoB: {
			Text1: 伟大的机器倒下了。很有趣...
			Text2: 你可能对你的旅程有很多疑问
			Text3: 你是谁？你的命运是什么？你从何而来？又是由什么造就了你？
			Text4: 如果你想了解这个世界的秘密，我会在世界深处开启一个传送门
		}
	}

	Noxus: {
		KilledYharim: {
			Text1: 嗯... 完美的容器...
			Text2: 混沌的完美造物
			Text3: 熵的障碍又少了一个
		}
	}
}
