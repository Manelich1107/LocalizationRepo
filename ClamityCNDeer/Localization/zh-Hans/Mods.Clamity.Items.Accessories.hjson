SoulOfPyrogen: {
	DisplayName: 极炎之魄
	Tooltip:
		'''
		提升10%近战与盗贼伤害
		真近战攻击和潜伏攻击会从地底呼唤长矛攻击
		'''
}

DraculasCharm: {
	DisplayName: 吸血鬼护身符
	Tooltip:
		'''
		盗贼伤害增加15%，最大潜伏值提升10点
		潜伏攻击会造成粉碎减益，并生成一个追踪的吸血鬼
		潜伏攻击增加8%伤害
		盗贼弹幕在暴击时获得生命窃取，消失时生成幻魂
		'''
}

PyroStone: {
	DisplayName: 火山石
	Tooltip:
		'''
		所有火焰减益的伤害倍率乘以1.5
		创造一个环绕着你的火盾，火盾会伤害并点燃与其接触的敌人
		"远古遗物之一"
		'''
}

HellFlare: {
	DisplayName: 阳炎之霜
	Tooltip:
		'''
		所有攻击和弹幕造成会造成狱炎减益
		使你免疫"着火了！"和"狱炎"减益
		生命值超过75%会增加10%的暴击几率
		生命值低于25%会增加10%的伤害减免
		使你获得对冷系攻击的抗性
		'''
}

SupremeBarrier: {
	DisplayName: 至尊屏障
	Tooltip:
		'''
		允许进行星陨冲刺
		冲刺期间可穿透敌人，且不会受到伤害
		对击退和火块免疫
		对绝大多数减益免疫，包括弑神怒焰
		增加受伤的无敌帧并召唤星星陨落
		生命值满额时提供 10 帧无敌时间；生命值降至 25% 及以下时，提升至 40 帧
		生命值高于 25% 时，为队内队友承担 25% 所受伤害
		当生命值低于50%时，周身生成护盾，减少受到的伤害
		单次受到 200 点以上伤害时，额外获得 30 帧无敌时间
		'''
	ToggleEffect: ", 提高移速,"
}

IcicleRing: {
	DisplayName: 寒狱冰戒
	Tooltip:
		'''
		魔力消耗降至零
		穿戴者持续承受痛苦带来的伤害
		'''
}

RedDie: {
	DisplayName: 红色骰子
	Tooltip:
		'''
		1.5倍幸运修正
		额外幸运提升20%
		"准备重掷命运了吗？"
		'''
}

EidolonAmulet: {
	DisplayName: 幽灵护符
	Tooltip:
		'''
		免疫激流、深渊压力和辐射减益
		所有攻击造成深渊压力减益并从天空释放酸雨
		在水下静止时可以恢复氧气（深渊中无效）
		潮湿时挖掘速度提升15%，伤害提升10%
		在深渊中生命值上限提升25%
		在深渊中提供适量光照
		'''
}

Wings: {
	MetalWings: {
		DisplayName: 青铜之翼
		Tooltip:
			'''
			水平速度：10.50
			加速倍率：2.8
			极佳的垂直速度
			飞行时间：280
			受到伤害时，获得等于受到伤害与最大生命值比率一半的飞行时间百分比
			穿戴寒狱套时，队伍中所有玩家获得20点防御力
			'''
	}
}

PearlOfFishCalamity: {
	DisplayName: 灾厄渔珠
	Tooltip:
		'''
		钓鱼力提升50点
		大幅提升钓到药水材料鱼的几率
		提升钓到宝匣的几率
		增加药水材料鱼的产量
		召唤一个水元素在钓鱼时保护你
		'''
}

SeaShell: {
	DisplayName: 海蜗牛壳
	Tooltip: 潮湿时提升防御力、伤害减免和移动速度
}

TheSubcommunity: {
	DisplayName: 社区之心
	Tooltip:
		'''
		[STATS]
		'来自灾厄社区的一份礼物。'
		'凝聚着社区的力量。'
		[c/B00BA5:感谢所有支持者让这个附加内容成为现实！]
		'''
	StatsList:
		'''
		提高挖掘速度{0}%
		提高{1}幸运值和{2}渔力
		提高{3}%放置方块和墙壁的速度和{4}放置范围
		随着击败Boss变得更强（{5}%攻击力）
		'''
}

MagicDiamond: {
	DisplayName: 魔法钻石
	Tooltip:
		'''
		造成魔法伤害时创造一个小型屏障
		每次魔法攻击都会为屏障增加少量耐久度
		屏障最多可储存20点耐久度
		'''
}

SharpAmethyst: {
	DisplayName: 锋利紫水晶
	Tooltip:
		'''
		射箭时有几率创造额外的宝石箭
		宝石箭造成箭矢20%的伤害
		'''
}

BlightedSpyglass: {
	DisplayName: 枯萎望远镜
	Tooltip:
		'''
		+1最大哨兵数量
		哨兵攻击会施加硫磺火焰
		'''
}

CyanPearl: {
	DisplayName: 青色珍珠
	Tooltip:
		'''
		+7%召唤伤害
		哨兵的召唤伤害惩罚减半
		'''
}

SkullOfTheBloodGod: {
	DisplayName: 血神之颅
	Tooltip:
		'''
		伤害提升20%且暴击率提升13%
		暴击会爆炸，使附近敌人被硫磺火焰点燃
		每20秒冷却时间减半敌人接触伤害
		受到伤害后硫磺火焰从天而降
		大幅减少硫磺火焰减益造成的伤害
		'''
}
