Items: {
	Mounts: {
		FlameCube: {
			DisplayName: 灾厄之盒
			Tooltip:
				'''
				召唤一个相当舒适、极其灵活的灾厄飞椅
				坐在飞椅上时按住[KEY]将会精确减速
				“温暖的玩家，往往是最危险的对手”
				“备注：以防你忘了，它免疫火焰”
				'''
		}

		PlagueStation: {
			DisplayName: 瘟疫之盒
			Tooltip:
				'''
				召唤一个相当舒适、极其灵活的瘟疫飞椅
				坐在飞椅上时按住[KEY]会精确减速
				“狂热的粉丝玩家，往往是最危险的感染源”
				'''
		}
	}

	BaseBook1: {
		DisplayName: 打印纸
		ObtainmentHint: "[c/F79BC6:这本书由普通的商人出售]"
		Tooltip: 只是一张普通的空白纸张
	}

	BaseBook2: {
		DisplayName: 常见手册
		ObtainmentHint: "[c/F79BC6:这本书由某个被诅咒的人出售]"
		Tooltip:
			'''
			只是一本普通的小册子，推荐你去各种地方旅行
			里面照例塞满了广告
			'''
	}

	BaseBook3: {
		DisplayName: 基础书籍
		ObtainmentHint: "[c/F79BC6:这本书由一位大法师出售]"
		Tooltip: 只是一本普通的书，没什么太有趣的地方
	}

	BaseBook4: {
		DisplayName: 常见典籍
		ObtainmentHint: "[c/F79BC6:这本书由一位喜欢住在神圣之地的巫师出售]"
		Tooltip:
			'''
			它用你确实看得懂的语言写成
			然而，这本典籍实际上毫无用处……
			'''
	}

	HowToClamity: {
		DisplayName: 灾蛤指导手册
		ObtainmentHint: "[c/F79BC6:一只逃入阿萨福勒的蛤蜊持有这本书]"
		Tooltip:
			'''
			一本教你如何制造灾蛤事件的指南
			读着读着，你开始感觉自己的理智正在滑落……
			你及时合上了书，但脑海里仍能听见蛤蜊咔哒作响
			'''
	}
}

